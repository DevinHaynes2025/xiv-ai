{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ],
      "@xiv/ai": [
        "../../services/ai/index.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "../../services/ai/**/*.ts"
  ],
  "exclude": [
    "../../services/ai/server.ts",
    "../../services/ai/gemini-provider.ts",
    "../../services/ai/auth.ts",
    "../../services/ai/audit.ts",
    "../../services/ai/executive-turn.ts",
    "../../services/ai/runtime/policy.test.ts",
    "../../services/ai/runtime/phase2b.test.ts",
    "../../services/ai/runtime/phase2c.test.ts",
    "../../services/ai/runtime/phase2d.test.ts",
    "../../services/ai/runtime/phase2e.test.ts",
    "../../services/ai/runtime/phase2fa.test.ts",
    "../../services/ai/runtime/phase2fb.test.ts",
    "../../services/ai/runtime/tenant/migration-review.ts",
    "../../services/ai/business-api.ts",
    "../../services/ai/runtime/guardian/host.ts",
    "../../services/ai/runtime/guardian/validate.ts"
  ]
}
