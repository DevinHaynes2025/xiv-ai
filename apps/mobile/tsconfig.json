{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ],
      "@xiv/ai": [
        "../../services/ai/index.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "../../services/ai/**/*.ts"
  ],
  "exclude": [
    "../../services/ai/server.ts",
    "../../services/ai/local-coding-worker.ts",
    "../../services/ai/hardware-probe.ts",
    "../../services/ai/model-backend.ts",
    "../../services/ai/gemini-provider.ts",
    "../../services/ai/auth.ts",
    "../../services/ai/audit.ts",
    "../../services/ai/executive-turn.ts",
    "../../services/ai/business-api.ts",
    "../../services/ai/**/*.test.ts",
    "../../services/ai/**/*.integration.ts",
    "../../services/ai/**/*.proof.ts",
    "../../services/ai/runtime/queued/**",
    "../../services/ai/runtime/tenant/hosted-isolation-harness.ts",
    "../../services/ai/runtime/tenant/hosted-activation.ts",
    "../../services/ai/runtime/tenant/migration-review.ts",
    "../../services/ai/runtime/tenant/reconciliation-review.ts",
    "../../services/ai/runtime/tenant/security-definer-review.ts",
    "../../services/ai/runtime/hosted-isolation-proof.ts",
    "../../services/ai/runtime/hosted-isolation-harness.test.ts",
    "../../services/ai/runtime/guardian/host.ts",
    "../../services/ai/runtime/guardian/validate.ts"
  ]
}
